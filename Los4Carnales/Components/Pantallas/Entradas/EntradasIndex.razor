@page "/Entrada/Index"
@using Microsoft.AspNetCore.Authorization
@using System.Linq.Expressions

@rendermode InteractiveServer
@inject EntradasServices entradasService
@inject NavigationManager navigationManager
@inject PageTitleService PageTitleService
@inject SweetAlertService Swal

@attribute [Authorize(Roles = "Administrador")]

<PageTitle>Registro de Entradas</PageTitle>

<div class="container">
    <div class="card card-glass rounded-4 p-2">
        <div class="card-body">

            @* --- FILTROS DE FECHA --- *@
            <div class="row align-items-end mb-3">
                <div class="col-md-3">
                    <label class="form-label text-muted small fw-bold mb-1">Desde</label>
                    <InputDate class="form-control input-glass" @bind-Value="FechaInicio" />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small fw-bold mb-1">Hasta</label>
                    <InputDate class="form-control input-glass" @bind-Value="FechaFin" />
                </div>
            </div>

            @* --- FILTROS DE BÚSQUEDA --- *@
            <div class="row align-items-end mb-4">
                <div class="col-md-3">
                    <label class="form-label text-muted small fw-bold mb-1">Filtrar por</label>
                    <InputSelect class="form-select input-glass" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opción</option>
                        <option value="Lote">Nº Lote</option>
                        <option value="Proveedor">Proveedor</option>
                        <option value="Concepto">Concepto / Factura</option>
                    </InputSelect>
                </div>

                <div class="col-md-3">
                    <label class="form-label text-muted small fw-bold mb-1">Búsqueda</label>
                    <div class="input-group">
                        <input class="form-control input-glass" @bind="ValorFiltro" placeholder="Escriba para buscar..." />
                        <button type="button" class="btn btn-outline-success bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>

                <div class="col-md-6 text-end">
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary bi bi-arrow-counterclockwise" @onclick="Restablecer"> Limpiar</button>
                        <a href="/Entrada/Create" class="btn btn-gradiente px-3">
                            <span class="bi bi-plus-square"></span> Nueva Entrada
                        </a>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover bg-transparent align-middle">
                    <thead class="text-black" style="background-color: rgba(0,0,0,0.03); border-bottom: 2px solid rgba(0,0,0,0.1);">
                        <tr>
                            <th class="py-3 ps-3">Nº Lote</th>
                            <th class="py-3">Fecha</th>
                            <th class="py-3">Proveedor</th>
                            <th class="py-3">Concepto</th>
                            <th class="py-3 text-center">Tipo</th>
                            <th class="py-3 text-center">Total Items</th>
                            <th class="py-3 text-center">Opciones</th>
                        </tr>
                    </thead>
                    <tbody style="background-color: transparent;">
                        @foreach (var entrada in ListaEntradas)
                        {
                            <tr style="border-bottom: 1px solid rgba(0,0,0,0.05);">
                                <td class="ps-3 fw-bold text-primary">@entrada.NumeroLote</td>
                                <td class="text-nowrap">@entrada.FechaEntrada.ToShortDateString()</td>
                                <td>@(entrada.Proveedor?.Nombre ?? "Desconocido")</td>
                                <td>@entrada.Concepto</td>
                                <td class="text-center">
                                    @if (entrada.EsFormal)
                                    {
                                        <span class="badge bg-primary">Formal</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Informal</span>
                                    }
                                </td>
                                <td class="text-center fw-bold" style="color: #3D5D35;">
                                    @entrada.EntradaDetalles.Sum(d => d.Cantidad)
                                </td>
                                <td class="text-center text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-info border-0 bi bi-info-circle fs-5" title="Info Extra" @onclick="() => MostrarInfoExtra(entrada)"></button>
                                    <a href="/Entrada/Edit/@entrada.EntradaId" class="btn btn-sm btn-outline-success border-0 bi bi-eye fs-5" title="Ver Detalle"></a>
                                </td>
                            </tr>
                        }
                        @if (!ListaEntradas.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No se encontraron entradas.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* --- FOOTER CON PAGINACIÓN --- *@
        <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between align-items-center text-muted mt-2 pt-0 pb-3 px-4">
            <small class="fw-bold">Total de Entradas: @TotalRegistros</small>

            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-secondary" @onclick="PaginaAnterior" disabled="@(!PuedeRetroceder)">
                    <span class="bi bi-chevron-left"></span> Anterior
                </button>
                <span class="small fw-bold text-dark mx-2">Página @PaginaActual de @TotalPaginas</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="PaginaSiguiente" disabled="@(!PuedeAvanzar)">
                    Siguiente <span class="bi bi-chevron-right"></span>
                </button>
            </div>
        </div>

        <div class="col-md-4 text-start p-2">
            <div class="d-flex justify-content-start gap-2">
                <a href="/Almacen" class="btn btn-outline-secondary border-0">
                    <span class="bi bi-arrow-left"></span> Volver
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    public List<Entrada> ListaEntradas { get; set; } = new List<Entrada>();

    // Variables de Búsqueda
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;
    public DateTime? FechaInicio { get; set; }
    public DateTime? FechaFin { get; set; }

    // Variables de Paginación
    public int PaginaActual { get; set; } = 1;
    public int RegistrosPorPagina { get; set; } = 8; // Muestra 8 registros por página
    public int TotalRegistros { get; set; } = 0;

    // Cálculos de Paginación
    public int TotalPaginas => TotalRegistros == 0 ? 1 : (int)Math.Ceiling((double)TotalRegistros / RegistrosPorPagina);
    public bool PuedeRetroceder => PaginaActual > 1;
    public bool PuedeAvanzar => PaginaActual < TotalPaginas;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Entradas de Almacén");
        FechaInicio = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
        FechaFin = DateTime.Now;

        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        // 1. Construir la consulta LINQ dinámicamente para que SQL Server haga el filtro
        Expression<Func<Entrada, bool>> criterio = e =>
            (!FechaInicio.HasValue || e.FechaEntrada.Date >= FechaInicio.Value.Date) &&
            (!FechaFin.HasValue || e.FechaEntrada.Date <= FechaFin.Value.Date) &&
            (string.IsNullOrWhiteSpace(ValorFiltro) ||
                (Filtro == "Proveedor" && e.Proveedor != null && e.Proveedor.Nombre.ToLower().Contains(ValorFiltro.ToLower())) ||
                (Filtro == "Concepto" && e.Concepto != null && e.Concepto.ToLower().Contains(ValorFiltro.ToLower())) ||
                (Filtro == "Lote" && e.NumeroLote != null && e.NumeroLote.ToLower().Contains(ValorFiltro.ToLower()))
            );

        // 2. Obtener la cantidad total de registros que coinciden con el filtro (para calcular las páginas)
        TotalRegistros = await entradasService.Contar(criterio);

        // 3. Traer SÓLO los registros de la página actual
        ListaEntradas = await entradasService.Listar(criterio, PaginaActual, RegistrosPorPagina);
    }

    private async Task Buscar()
    {
        PaginaActual = 1; // Al buscar, siempre volvemos a la página 1
        await CargarDatos();
    }

    private async Task Restablecer()
    {
        Filtro = string.Empty;
        ValorFiltro = string.Empty;
        FechaInicio = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
        FechaFin = DateTime.Now;
        PaginaActual = 1;

        await CargarDatos();
    }

    // Navegación
    private async Task PaginaAnterior()
    {
        if (PuedeRetroceder)
        {
            PaginaActual--;
            await CargarDatos();
        }
    }

    private async Task PaginaSiguiente()
    {
        if (PuedeAvanzar)
        {
            PaginaActual++;
            await CargarDatos();
        }
    }

    private async Task MostrarInfoExtra(Entrada entrada)
    {
        string htmlInfo = entrada.EsFormal
            ? $"<div class='text-start'><p><b>Orden de Compra:</b> {(string.IsNullOrEmpty(entrada.OrdenCompra) ? "N/A" : entrada.OrdenCompra)}</p>" +
              $"<p><b>Cotización:</b> {(string.IsNullOrEmpty(entrada.Cotizacion) ? "N/A" : entrada.Cotizacion)}</p>" +
              $"<p><b>Fecha de Orden:</b> {(entrada.FechaOrdenCompra.HasValue ? entrada.FechaOrdenCompra.Value.ToShortDateString() : "N/A")}</p>" +
              $"<p><b>Razón Social:</b> {entrada.RazonSocial}</p>" +
              $"<p><b>RNC Empresa:</b> {entrada.RncEmpresa}</p>" +
              $"<p><b>RNC Proveedor:</b> {entrada.RncProveedor}</p>" +
              $"<p><b>Acuerdo de Pago:</b> {entrada.AcuerdoPagoDias} Días</p></div>"
            : $"<div class='text-center'><p><b>Orden de Compra:</b> {(string.IsNullOrEmpty(entrada.OrdenCompra) ? "N/A" : entrada.OrdenCompra)}</p><span class='badge bg-secondary'>Entrada Informal</span></div>";

        await Swal.FireAsync(new SweetAlertOptions
        {
            Title = $"Detalle Extra (Lote: {entrada.NumeroLote})",
            Html = htmlInfo,
            Icon = SweetAlertIcon.Info
        });
    }
}