@page "/Master/Transferencias"

@using Los4Carnales.Models
@using Los4Carnales.Services
@using Los4Carnales.Components.Layout

@layout MasterLayout
@rendermode InteractiveServer

@inject PageTitleService PageTitleService
@inject TranferenciaServices transferenciaService
@inject IJSRuntime JS

@attribute [Authorize(Roles = "Master")]

<PageTitle>@PageTitleService.CurrentTitle</PageTitle>

<div class="top-header-master">
    @PageTitleService.CurrentTitle
</div>

<div class="content-body">
    <div class="controls-bar">
        <div class="d-flex gap-4">
            <div>
                <div class="filter-label">Filtrar por:</div>
                <select class="input-custom" @bind="CriterioFiltro">
                    <option value="Origen">Banco Origen</option>
                    <option value="Destino">Banco Destino</option>
                </select>
            </div>

            <div>
                <div class="filter-label">Buscar</div>
                <div class="d-flex gap-1">
                    <input type="text" class="input-custom" placeholder="Escribe para buscar..."
                           @bind="TextoBusqueda" @bind:event="oninput" style="width: 250px;">
                    <button class="input-custom bg-white border"><i class="bi bi-search"></i></button>
                </div>
            </div>
        </div>

        <div class="badge-counter">
            <i class="bi bi-trash3-fill"></i>
            <div>
                <div class="fs-4 fw-bold lh-1 text-dark">@ListaFiltrada.Count</div>
                <small class="text-muted">Eliminados</small>
            </div>
        </div>
    </div>

    <div class="big-card-container">
        @* Encabezado de la Tabla *@
        <div class="table-header">
            <div style="width: 60px;">ID</div>
            <div style="width: 10%;">Cliente</div>
            <div style="width: 20%;">Origen</div>
            <div style="width: 20%;">Destino</div>
            <div style="width: 15%;">Monto</div>
            <div style="width: 15%;">Fecha</div>
            <div style="width: 10%; text-align: center;">Estado</div>
            <div style="width: 120px; text-align: right;">Opciones</div>
        </div>

        @if (ListaTransferencias.Count == 0)
        {
            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted mt-5">
                <i class="bi bi-inbox fs-1 mb-3"></i>
                <h4>La papelera está vacía</h4>
                <p>No hay transferencias eliminadas recientemente.</p>
            </div>
        }
        else
        {
            @foreach (var item in ListaFiltrada)
            {
                @* Fila de Datos Única *@
                <div class="data-row">
                    <div style="width: 60px;" class="fw-bold">#@item.TransferenciaId</div>

                    <div style="width: 10%;">ID: @item.ClienteId</div>

                    <div style="width: 20%;" class="fw-bold text-dark">@item.Origen</div>

                    <div style="width: 20%;" class="fw-bold text-dark">@item.Destino</div>

                    <div style="width: 15%;" class="fw-bold text-success">@item.Monto.ToString("N2")</div>

                    <div style="width: 15%;" class="col-date">
                        @item.Fecha.ToString("dd/MM/yyyy")
                    </div>

                    <div style="width: 10%; text-align: center;" class="col-status">
                        <span class="badge bg-danger">Eliminado</span>
                    </div>

                    <div style="width: 120px; text-align: right;" class="col-actions">
                        <button class="action-btn btn-restore" title="Restaurar"
                                @onclick="() => Restaurar(item.TransferenciaId)">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>

                        <button class="action-btn btn-delete" title="Eliminar Permanente"
                                @onclick="() => EliminarDefinitivamente(item.TransferenciaId)">
                            <i class="bi bi-trash3-fill"></i>
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    public List<Transferencia> ListaTransferencias { get; set; } = new List<Transferencia>();
    public string TextoBusqueda { get; set; } = "";
    public string CriterioFiltro { get; set; } = "Origen";

    public List<Transferencia> ListaFiltrada
    {
        get
        {
            if (string.IsNullOrWhiteSpace(TextoBusqueda))
                return ListaTransferencias;

            return CriterioFiltro switch
            {
                "Origen" => ListaTransferencias.Where(p => p.Origen.Contains(TextoBusqueda, StringComparison.OrdinalIgnoreCase)).ToList(),
                "Destino" => ListaTransferencias.Where(p => p.Destino.Contains(TextoBusqueda, StringComparison.OrdinalIgnoreCase)).ToList(),
                _ => ListaTransferencias
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Transferencias Papelería");
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        // Se asume que el service ya filtra por Eliminado == true
        ListaTransferencias = await transferenciaService.ListarPapelera();
    }

    private async Task Restaurar(int id)
    {
        var exito = await transferenciaService.Restaurar(id);
        if (exito) await CargarDatos();
    }

    private async Task EliminarDefinitivamente(int id)
    {
        bool confirmar = await JS.InvokeAsync<bool>("confirm", "⚠️ ¿Estás seguro de eliminar esta transferencia PERMANENTEMENTE?");
        if (confirmar)
        {
            var exito = await transferenciaService.EliminarPermanente(id);
            if (exito) await CargarDatos();
        }
    }
}